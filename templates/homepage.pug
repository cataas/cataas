extends layout

block content
    - const endpoints = [ ['/cat', 'random'], ['/cat/:tag', 'tag', '/cat/orange,cute'], ['/cat/gif', 'gif'], ['/cat/says/:text', 'says', '/cat/says/hello'], ['/cat/:tag/says/:text', 'tagsays', '/cat/cute/says/hello'], ['/cat/says/:text?fontSize=50&fontColor=red', 'style', '/cat/says/hello?fontSize=50&fontColor=red'], ['/cat?type=square', 'type'], ['/cat?filter=mono', 'filter'], ['/cat?filter=custom&r=7&g=12&b=50', 'custom'], ['/cat?width=100&height=100', 'size', '/cat?width=100&height=100'], ['/cat?html=true', 'html'], ['/cat?json=true', 'json'], ['/api/cats?tags=cute', 'cats'], ['/api/tags', 'tags'] ]

    section#top.container.hero
        div.hero__text
            span.badge= t('home.hero.badge')
            h1.hero__title
                = t('home.hero.title_a')
                br
                = t('home.hero.title_b') + ' '
                em= t('home.hero.title_c') + '.'
            p.hero__lead= t('home.hero.lead')
            div.hero__actions
                a.btn.btn--primary(href="#demo")= t('home.hero.try')
                a.btn.btn--ghost(href="#api")= t('home.hero.endpoints')
            div.code.hero__curl
                span.prompt $
                |  curl 
                strong https://cataas.com/cat
                |  -o cat.jpg

        div#demo.card.demo(
            data-demo
            data-error=t('home.demo.error')
            data-copied=t('home.demo.copied')
            data-copy=t('home.demo.copy')
        )
            div.demo__stage(data-stage)
                img(data-image, alt=t('home.demo.alt'))
            div.demo__group
                label.demo__label(for="demo-text")= t('home.demo.text')
                div.field(style="margin:0")
                    input#demo-text(type="text", value="Hello World!", maxlength="40", data-text, autocomplete="off")
            div.demo__group
                span.demo__label= t('home.demo.filter')
                div.demo__chips
                    each key in ['none', 'mono', 'negate', 'blur']
                        button.chip(type="button", data-filter=key, aria-pressed=key === 'none' ? 'true' : 'false')= t(`home.demo.filters.${key}`)
            div.demo__group
                span.demo__label= t('home.demo.format')
                div.demo__chips
                    each key in ['default', 'gif']
                        button.chip(type="button", data-format=key, aria-pressed=key === 'default' ? 'true' : 'false')= t(`home.demo.formats.${key}`)
            div.demo__url
                div.code(data-url)
                button.btn.btn--ghost.btn--sm(type="button", data-copy-url)= t('home.demo.copy')
            button.btn.btn--primary(type="button", data-another)= t('home.demo.another')

    section.container.stats(aria-label="Key figures")
        div.stats__item
            div.stats__value#count 0
            div.stats__label= t('home.stats.cats')
        div.stats__item
            div.stats__value $0
            div.stats__label= t('home.stats.free')
        div.stats__item
            div.stats__value 0 keys
            div.stats__label= t('home.stats.keys')
        div.stats__item
            div.stats__value JPG · PNG · GIF
            div.stats__label= t('home.stats.formats')

    section#api.container.section
        div.heading
            span.eyebrow / API
            h2= t('home.api.title')
        div.endpoints
            each e in endpoints
                article.card.endpoints__item
                    code.endpoints__path= e[0]
                    p.endpoints__desc= t(`home.api.${e[1]}`)
                    a.btn.btn--ghost.btn--sm.endpoints__try(href=e[2] || e[0].split(':')[0].replace(/\/$/, '') || '/', target="_blank", rel="noopener")= t('home.api.try')
            article.card.endpoints__item
                code.endpoints__path= t('home.api.more_title')
                p.endpoints__desc= t('home.api.more_desc')
                a.btn.btn--primary.btn--sm.endpoints__try(href="/doc.html")= t('home.api.more_link')

    section#usage.container.section
        div.usage
            div.usage__text
                span.eyebrow / Usage
                h2= t('home.usage.title')
                p.lead= t('home.usage.lead')
                p.lead= t('home.usage.uses')
            div.card.code.usage__code
                | &lt;<span class="k">img</span> <span class="a">src</span>="https://cataas.com/cat/says/hello"
                |      <span class="a">alt</span>="A cat saying hello"&gt;
                |
                |
                | <span class="c">/* #{t('home.usage.resize')} */</span>
                | https://cataas.com/cat?width=400&amp;height=300&amp;filter=mono
                |
                | <span class="c">/* #{t('home.usage.json')} */</span>
                | https://cataas.com/cat?json=true

    section.container.section
        div.cta
            h2= t('home.cta.title')
            a.btn.btn--dark(href="/doc.html")= t('home.cta.button')
