.site-bar
    header.site-header.container
        a.site-header__brand(href="/")
            svg(width="30", height="30", viewBox="0 0 30 30", aria-hidden="true")
                path(d="M4 26V6l7 6h8l7-6v20z", fill="#C6F432")
                circle(cx="11.5", cy="18", r="1.8", fill="#0E0F13")
                circle(cx="18.5", cy="18", r="1.8", fill="#0E0F13")
            | CATAAS
        nav.site-header__nav(aria-label="Main navigation")
            a.site-header__link(href="/#demo")= t('nav.demo')
            a.site-header__link(href="/#api")= t('nav.api')
            a.site-header__link(href="/#usage")= t('nav.usage')
            a.site-header__link(href="/upload")= t('nav.upload')
            a.btn.btn--outline(href="https://www.buymeacoffee.com/kevinbalicot", target="_blank", rel="noopener")= t('nav.support')
            a.btn.btn--primary(href="/doc.html")= t('nav.docs')
