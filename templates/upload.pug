extends layout

block content
    section.container.section
        header.heading
            span.eyebrow= t('upload.eyebrow')
            h2= t('upload.title')

        div.card
            if error
                p.alert.alert--error= error

            if ok
                p.alert.alert--success= t('upload.ok')

            form(method="post", enctype="multipart/form-data")
                div.field
                    label(for="file")= t('upload.file')
                    input(type="file", name="file", id="file", accept="image/*", required)

                div.field
                    label(for="tags")= t('upload.tags')
                    input(type="text", name="tags", id="tags", placeholder=t('upload.tags_placeholder'), required)
                    span.hint= t('upload.tags_help')

                button.btn.btn--primary(type="submit")= t('upload.submit')
